{
  "name": "@commerce-copilot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "dev:legacy": "node --experimental-strip-types src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.workspace.ts --project node apps/api"
  },
  "dependencies": {
    "@commerce-copilot/agent": "workspace:*",
    "@commerce-copilot/application": "workspace:*",
    "@commerce-copilot/connectors": "workspace:*",
    "@commerce-copilot/contracts": "workspace:*",
    "@commerce-copilot/domain": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/swagger": "11.4.5",
    "fastify": "5.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "tsx": "4.23.0"
  }
}
